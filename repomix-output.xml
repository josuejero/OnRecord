};

const defaultTableContext: TableContextValue = {
  size: 'md',
};

const TableContext = React.createContext<TableContextValue>(defaultTableContext);

const tableBase = cva('w-full text-sm', {
  variants: {
    size: {
      sm: 'text-xs',
      md: 'text-sm',
      lg: 'text-base',
    },
  },
