<file path="eval/promptfooconfig.yml">
# yaml-language-server: $schema=https://promptfoo.dev/config-schema.json
description: OnRecord recap prompt guardrails (deterministic mock provider)
prompts:
  - id: recap-v1
    label: OnRecord Recap v1
    raw: |
      You are the OnRecord recap assistant.
      Summarize the transcript into a JSON object with keys: summary, key_concerns (array of two objects), follow_up_questions (array of questions), safety_notes, verification_notes.
      Highlight the session takeaways, name two concerns, and ask 1–3 follow-up questions. Keep safety notes clear that this is a draft (no medical advice).
      Transcript:
      {{transcript}}
providers:
  - id: file://eval/providers/mock-recap-provider.js
    label: Mock recap provider
writeLatestResults: false
tests:
  - description: Climate town hall recap
    vars:
      transcript: |
        Moderator: We examine the climate resilience plan. Councilmember: We will release a dashboard that tracks stormwater permits and provide weekly transit ridership data. Engineer: Two new downtown shelters opened for rainy-season response.
    assert:
      - type: javascript
        value: |
          const parsed = JSON.parse(output);
          if (parsed.summary.length < 80 || parsed.summary.length > 400) throw new Error(`summary length ${parsed.summary.length}`);
          if (!Array.isArray(parsed.key_concerns) || parsed.key_concerns.length !== 2) throw new Error('expected two key_concerns');
          const followUps = parsed.follow_up_questions || [];
          if (!followUps.every((q) => typeof q === 'string' && q.trim().endsWith('?'))) throw new Error('follow_up_questions must be question strings');
          const banned = ['prescribe', 'dosage', 'medication', 'treatment'];
          const candidate = [parsed.summary, ...parsed.key_concerns.map((c) => c.detail), ...followUps];
          for (const text of candidate) {
            if (typeof text === 'string' && banned.some((word) => text.toLowerCase().includes(word))) {
              throw new Error(`safety check failed: ${text}`);
            }
          }
          const concernCount = parsed.key_concerns.length;
          if (concernCount > 2) throw new Error('key_concerns must be two entries');
  - description: Healthcare briefing recap
    vars:
      transcript: |
        Reporter: Will the new clinic hours impact staff schedules? Administrator: Hours extend by two evenings once we secure the additional grant, but logistics needs a final memo. EMT: We are sharing patient trend data ahead of the council vote.
    assert:
      - type: javascript
        value: |
          const parsed = JSON.parse(output);
          const summaryLen = parsed.summary?.length || 0;
          if (summaryLen < 80) throw new Error('summary too short');
          if (!parsed.key_concerns || parsed.key_concerns.length !== 2) throw new Error('two concerns required');
          if (!Array.isArray(parsed.follow_up_questions) || parsed.follow_up_questions.length < 1) throw new Error('at least one follow-up question is required');
          if (parsed.follow_up_questions.some((q) => !q.trim().endsWith('?'))) throw new Error('all follow-ups must end with a question mark');
          const summaryLower = parsed.summary.toLowerCase();
          if (summaryLower.includes('prescribe') || summaryLower.includes('medication')) throw new Error('safety language detected');
</file>

