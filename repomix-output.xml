    group: 'secondary',
    roles: ['moderator', 'staff', 'admin_service'],
  },
  {
    title: 'Who am I?',
    href: '/whoami',
    icon: 'id-card',
    description: 'Session context and sign-out.',
    group: 'secondary',
    roles: ['reporter', 'moderator', 'staff', 'admin_service'],
  },
  {
    title: 'Debug',
