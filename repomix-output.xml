              </Button>
              <span className="text-xs text-slate-500">Status: {statusLabelMap[status]}</span>
            </div>
          ) : null}
          {error ? (
            <div className="text-xs text-red-600" aria-live="polite">
              {error.message}
            </div>
          ) : null}
          <Button data-testid="save-transcript-button" type="submit">
